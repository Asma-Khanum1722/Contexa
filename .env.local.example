# ─────────────────────────────────────────────────────────────────
# Contexa — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────

# Google Gemini API Key (free tier at ai.google.dev or Google AI Studio)
GEMINI_API_KEY=

# Pinecone — create a free index at pinecone.io
# Index dimension MUST be 768 (text-embedding-004 output size) with Cosine metric
PINECONE_API_KEY=
PINECONE_INDEX=

# The public URL of this deployment (no trailing slash)
# e.g. https://contexa.vercel.app   or   http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Optional Model Configurations ─────────────────────────────────
# Defaults to gemini-1.5-flash and text-embedding-004
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── Firebase Authentication ───────────────────────────────────────
# Create a Firebase project at console.firebase.google.com
# Enable Google sign-in under Authentication → Sign-in method
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Optional — Rate Limiting (recommended for production) ─────────
# Create a free Redis database at upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
